<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Battle/Styles/CommandPanel.uss?fileID=7433441132597879392&amp;guid=9f8dcf9f23a07fe4286be0acd2452fd2&amp;type=3#CommandPanel"/>
    <ui:VisualElement name="BattleUI" style="flex-grow: 1; flex-direction: column;">
        <ui:VisualElement name="PlayerUnitHUDContainer" style="flex-grow: 1; position: absolute; height: 60%; width: 18.5%; -unity-background-scale-mode: stretch-to-fill; padding-top: 10px; padding-bottom: 10px; padding-right: 10px; padding-left: 10px; top: 0; right: 0;"/>
        <ui:VisualElement name="TurnOrderPanel" style="position: absolute; top: 30px; left: 30px; flex-direction: row; border-top-width: 0; border-right-width: 0; border-bottom-width: 2px; border-left-width: 0; border-left-color: rgb(201, 194, 194); border-right-color: rgb(201, 194, 194); border-top-color: rgb(201, 194, 194); border-bottom-color: rgb(201, 194, 194); width: 78%; height: 10%; align-items: flex-end;">
            <ui:Image name="CurrentTurnIcon" source="project://database/Assets/Sprites/Units/HeroKnight.png?fileID=-7357797988063737743&amp;guid=70cc7e388c0b7884aac6dbc93683cded&amp;type=3#HeroKnight_0" scale-mode="ScaleToFit" style="border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-right: 20px; margin-left: 20px; width: 110px; height: 90px; margin-bottom: 7px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="CommandPanel" style="position: absolute; height: 22%; width: 14%; background-color: rgba(0, 0, 0, 0); align-self: flex-start; left: 20px; bottom: 20px;">
            <ui:Button text="Attack" name="AttackButton" selectable="true" double-click-selects-word="false" triple-click-selects-line="false" class="battle-command-button"/>
            <ui:Button text="Skills" name="SkillsButton" selectable="true" double-click-selects-word="false" triple-click-selects-line="false" class="battle-command-button"/>
            <ui:Button text="Heal" name="HealButton" selectable="true" double-click-selects-word="false" triple-click-selects-line="false" class="battle-command-button"/>
            <ui:Button text="Defend" name="DefendButton" selectable="true" double-click-selects-word="false" triple-click-selects-line="false" class="battle-command-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
